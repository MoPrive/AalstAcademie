@* Sprint 003: Toont naast de bestaande login uitsluitend de complete tijdelijke demohint in een gewone details/summary-widget. Dit werkt zonder JavaScript en bevat geen permanent wachtwoord. *@
@page
@model AalstAcademie.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Aanmelden";
}
@* Het POST-formulier krijgt via de form-taghelper een antiforgerytoken; ReturnUrl wordt serverzijdig gecontroleerd. *@
<h1>Aanmelden</h1>
@* Gewone details/summary werkt zonder JavaScript; alleen de complete Development-demo levert deze tijdelijke hint. *@
@if (Model.DemoHint is { } hint)
{
    <details class="mb-3">
        <summary>Aanmeldgegevens voor de fictieve demosessie</summary>
        <p>Deze zes fictieve accounts gebruiken hetzelfde tijdelijke wachtwoord. Na een nieuwe demo-opstart veranderen de aanmeldgegevens.</p>
        <p><strong>Wachtwoord voor deze sessie:</strong> <span>@hint.Password</span></p>
        <ul>
            @foreach (var email in hint.Emails)
            {
                <li><span>@email</span></li>
            }
        </ul>
    </details>
}
<form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="account-form">
    @* De foutensamenvatting is aankondigbaar en focusbaar; het gedeelde script verplaatst focus na een fout. *@
    <div asp-validation-summary="All" class="text-danger validation-summary" role="alert" tabindex="-1"></div>
    @* Labels en autocomplete helpen toetsenbordgebruikers, schermlezers en wachtwoordbeheerders. *@
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">E-mailadres</label>
        <input asp-for="Input.Email" type="email" autocomplete="username" class="form-control" required />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Wachtwoord</label>
        @* Een mislukte aanmelding mag het geposte wachtwoord niet opnieuw in de HTML opnemen. *@
        <input asp-for="Input.Password" type="password" value="" autocomplete="current-password" class="form-control" required />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label">Aangemeld blijven op dit toestel</label>
    </div>
    <button type="submit" class="btn btn-primary">Aanmelden</button>
</form>
<p class="mt-3"><a asp-page="Register">Account aanvragen</a></p>
<p class="form-text">Voor hulp bij toegang neem je contact op met de beheerder.</p>
@section Scripts {
    <script src="~/js/registration-form.js" asp-append-version="true"></script>
}
