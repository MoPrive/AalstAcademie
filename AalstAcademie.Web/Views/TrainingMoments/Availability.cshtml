@* Sprint 003: Toont een gelezen zaalbeschikbaarheid en een apart POST-boekingsformulier. De gekozen zaal en interval blijven staan; opslaan kan alsnog een actuele conflictmelding geven. *@
@using AalstAcademie.Web.Models.Training
@model TrainingMomentAvailabilityViewModel
@{ ViewData["Title"] = "Zaalbeschikbaarheid"; }
@* Dit is een scoped momentopname: zaal/interval/capaciteit, zonder bezetting of deelnemersgegevens. *@
<h1>Zaalbeschikbaarheid</h1><p>@Model.TrainingTitle</p>
<p>@Model.Date, @Model.StartTime – @Model.EndTime (Belgische tijd); maximum @Model.MaximumParticipants.</p>
<p>De getoonde beschikbaarheid reserveert geen zaal. Opslaan controleert de actuele planning opnieuw.</p>
<div asp-validation-summary="All" class="text-danger training-validation-summary" role="alert" tabindex="-1" autofocus></div>
<ul class="availability-rooms">@foreach (var room in Model.Rooms) {
<li>@room.Name — @room.Address — capaciteit @room.MaximumCapacity — @(room.IsAvailable ? "beschikbaar" : "niet beschikbaar")</li> }</ul>
@if (Model.CanEdit && Model.Rooms.Count > 0)
{
<form action="@(Model.MomentId is int id ? $"/TrainingMoments/Edit/{id}" : $"/TrainingMoments/Create/{Model.TrainingId}")" method="post" class="moment-planning">
@Html.AntiForgeryToken()
<input type="hidden" name="Date" value="@Model.Date" /><input type="hidden" name="StartTime" value="@Model.StartTime" /><input type="hidden" name="EndTime" value="@Model.EndTime" />
@if (Model.MomentId is not null) { <input type="hidden" name="ExpectedVersion" value="@Model.ExpectedVersion" /> }
else { <input type="hidden" name="MaximumParticipants" value="@Model.MaximumParticipants" /> }
<label for="save-room">Zaal</label><select id="save-room" name="LocationId" class="form-select">
<option value="">Kies een zaal</option>
@if (!string.IsNullOrWhiteSpace(Model.LocationId) && !Model.Rooms.Any(x => x.Id.ToString() == Model.LocationId))
{ <option value="@Model.LocationId" selected>Oorspronkelijke keuze @Model.LocationId — herlees de zalen</option> }
@foreach (var room in Model.Rooms)
{ <option value="@room.Id" selected="@(room.Id.ToString() == Model.LocationId)">@room.Name — capaciteit @room.MaximumCapacity — @(room.IsAvailable ? "beschikbaar" : "niet beschikbaar")</option> }
</select><button class="btn btn-primary mt-3" type="submit">@(Model.MomentId is null ? "Moment aanmaken" : "Planning opslaan")</button></form>
}
else if (!Model.CanEdit) { <p class="alert alert-info">Dit moment kan niet worden gewijzigd. Herlees de opleiding.</p> }
<p class="mt-3"><a href="@(Model.MomentId is int momentId ? $"/TrainingMoments/Edit/{momentId}" : $"/TrainingMoments/Create/{Model.TrainingId}")">Planning opnieuw lezen</a></p>
<p><a asp-controller="TrainingManagement" asp-action="Details" asp-route-id="@Model.TrainingId">Terug naar de opleiding</a></p>

