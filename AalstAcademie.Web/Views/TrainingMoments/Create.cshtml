@* Sprint 003: Vraagt planning en maximum en haalt met een gewone GET passende zalen op. De latere POST schrijft; de volledige stroom werkt zonder JavaScript. *@
@using AalstAcademie.Web.Models.Training
@model TrainingMomentCreateViewModel
@{ ViewData["Title"] = "Opleidingsmoment aanmaken"; }
@* GET leest zaalbeschikbaarheid zonder CSRF-token in de URL; alleen de aparte POST schrijft. *@
<h1>Opleidingsmoment aanmaken</h1><p>@Model.TrainingTitle</p>
<p><a asp-controller="TrainingManagement" asp-action="Details" asp-route-id="@Model.TrainingId">Terug naar de opleiding</a></p>
<div asp-validation-summary="All" class="text-danger training-validation-summary" role="alert" tabindex="-1" autofocus></div>
<form action="/TrainingMoments/Availability" method="get" class="moment-planning">
<input type="hidden" name="trainingId" value="@Model.TrainingId" />
<fieldset><legend class="h5">Planning in Belgische tijd</legend>
<label for="lookup-date">Datum (JJJJ-MM-DD)</label><input id="lookup-date" name="Date" value="@Model.Date" class="form-control" placeholder="2026-12-15" />
<label for="lookup-start">Begintijd</label><input id="lookup-start" name="StartTime" value="@Model.StartTime" class="form-control" placeholder="14:00" />
<label for="lookup-end">Eindtijd</label><input id="lookup-end" name="EndTime" value="@Model.EndTime" class="form-control" placeholder="16:00" />
<p class="form-text">UU:mm of UU:mm:ss met hoogstens zeven fractiecijfers. Begin en einde vallen op dezelfde dag.</p></fieldset>
<label for="lookup-max">Maximum deelnemers</label><input id="lookup-max" name="MaximumParticipants" value="@Model.MaximumParticipants" class="form-control" inputmode="numeric" />
<input type="hidden" name="LocationId" value="@Model.LocationId" />
<button class="btn btn-primary mt-3" type="submit">Toon zalen</button></form>
@if (Model.Rooms.Count > 0 || !string.IsNullOrWhiteSpace(Model.LocationId))
{
<p class="mt-3">De getoonde beschikbaarheid reserveert geen zaal. Opslaan controleert de actuele planning opnieuw.</p>
<form asp-action="Create" asp-route-trainingId="@Model.TrainingId" method="post" class="moment-planning">
<input type="hidden" name="Date" value="@Model.Date" /><input type="hidden" name="StartTime" value="@Model.StartTime" /><input type="hidden" name="EndTime" value="@Model.EndTime" /><input type="hidden" name="MaximumParticipants" value="@Model.MaximumParticipants" />
<label for="save-room">Zaal</label><select id="save-room" name="LocationId" class="form-select">
<option value="">Kies een zaal</option>
@if (!string.IsNullOrWhiteSpace(Model.LocationId) && !Model.Rooms.Any(x => x.Id.ToString() == Model.LocationId))
{ <option value="@Model.LocationId" selected>Oorspronkelijke keuze @Model.LocationId — herlees de zalen</option> }
@foreach (var room in Model.Rooms)
{ <option value="@room.Id" selected="@(room.Id.ToString() == Model.LocationId)">@room.Name — capaciteit @room.MaximumCapacity — @(room.IsAvailable ? "beschikbaar" : "niet beschikbaar")</option> }
</select><button type="submit" class="btn btn-primary mt-3">Moment aanmaken</button></form>
}
<p class="mt-3"><a asp-action="Create" asp-route-trainingId="@Model.TrainingId">Formulier opnieuw lezen</a></p>

