@* Sprint 003: Vraagt alleen het nieuwe deelnemersmaximum en de oude versie, naast het noodzakelijke bezettingstotaal. Namen en motivaties van deelnemers worden niet getoond. *@
@using AalstAcademie.Web.Models.Training
@model TrainingMomentCapacityViewModel
@{ ViewData["Title"] = "Deelnemersmaximum wijzigen"; var moment = Model.Details.Moment; }
@* Alleen de noodzakelijke aggregate verschijnt: geen namen, motivatie of deelnamelijst. *@
<h1>Deelnemersmaximum wijzigen</h1><p>@moment.TrainingTitle</p>
<p><a asp-controller="TrainingManagement" asp-action="Details" asp-route-id="@moment.TrainingId">Terug naar de opleiding</a></p>
<p>Minimaal @Math.Max(1, Model.Details.OccupiedCount); zaalcapaciteit @moment.LocationMaximumCapacity. Planning en zaal blijven behouden.</p>
<div asp-validation-summary="All" class="text-danger training-validation-summary" role="alert" tabindex="-1" autofocus></div>
@if (Model.Details.CanEditCapacity)
{
<form asp-action="Capacity" asp-route-id="@moment.Id" method="post" class="moment-planning">
<input type="hidden" name="ExpectedVersion" value="@Model.ExpectedVersion" />
<label asp-for="MaximumParticipants"></label><input asp-for="MaximumParticipants" class="form-control" inputmode="numeric" />
<span asp-validation-for="MaximumParticipants" class="text-danger"></span>
<button class="btn btn-primary mt-3" type="submit">Maximum opslaan</button></form>
}
else { <p class="alert alert-info">Een gestart of geannuleerd moment kan niet meer worden gewijzigd.</p><p>Ingevoerd maximum: @Model.MaximumParticipants.</p><input type="hidden" name="OriginalExpectedVersion" value="@Model.ExpectedVersion" /> }
<p class="mt-3"><a asp-action="Capacity" asp-route-id="@moment.Id">Moment opnieuw lezen</a></p>

