@using AalstAcademie.Web.Models.Enrolment
@model TrainingMomentCancelViewModel
@{ ViewData["Title"] = "Opleidingsmoment annuleren"; var row = Model.Moment; }
<h1>Opleidingsmoment annuleren</h1><h2 class="h5">@row.Title</h2>
<p>@row.Date.ToString("dd/MM/yyyy") @row.StartTime.ToString("HH:mm") — @row.Location</p>
<div asp-validation-summary="All" class="text-danger validation-summary" role="alert" tabindex="-1"></div>
<p class="alert alert-warning">Dit annuleert het volledige moment met @row.RequestedCount aanvragen en @row.ConfirmedCount bevestigingen. De betrokken deelnemers keren terug naar de opleidingswachtlijst. Bestaande actieve aansluitingen blijven behouden. De zaal komt vrij zodra de annulering is opgeslagen.</p>
<form method="post" asp-action="Cancel" asp-route-id="@row.Id">
    <input type="hidden" name="ExpectedMomentVersion" value="@EnrolmentHttpForms.Raw(ViewData.ModelState, "ExpectedMomentVersion", Model.Input.ExpectedMomentVersion)" />
    <button type="submit" class="btn btn-danger" disabled="@(Model.IsConflict || !row.CanCancel)">Volledig moment annuleren</button>
</form>
<p><a asp-action="Cancel" asp-route-id="@row.Id">Dit moment bewust opnieuw lezen</a> — <a asp-controller="TrainingManagement" asp-action="Details" asp-route-id="@row.TrainingId">Terug naar de opleiding</a></p>
@section Scripts { <script src="~/js/registration-form.js" asp-append-version="true"></script> }
