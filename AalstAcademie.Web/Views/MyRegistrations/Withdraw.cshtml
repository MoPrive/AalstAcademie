@using AalstAcademie.Web.Models.Enrolment
@model EmployeeWithdrawViewModel
@{ ViewData["Title"] = "Wachtlijstaansluiting intrekken"; var version = EnrolmentHttpForms.Raw(ViewData.ModelState, "ExpectedVersion", Model.Input.ExpectedVersion); }
<h1>Wachtlijstaansluiting intrekken</h1>
<div asp-validation-summary="All" class="text-danger validation-summary" role="alert" tabindex="-1"></div>
<p>@Model.Entry.Title — aangesloten (UTC) @Model.Entry.JoinedAtUtc.ToString("dd/MM/yyyy HH:mm")</p>
<p>Je trekt alleen deze concrete aansluiting in. Dit verwijdert geen historie en start geen automatische aanvraag.</p>
<form method="post" action="/MyRegistrations/Withdraw/@Model.Entry.Id" class="account-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ExpectedVersion" value="@version" />
    @if (!Model.IsConflict && Model.Entry.ClosedAtUtc is null) { <button type="submit" class="btn btn-primary">Deze aansluiting intrekken</button> }
</form>
<p class="training-actions mt-3"><a href="/MyRegistrations/Withdraw/@Model.Entry.Id">Bewust opnieuw lezen</a><a href="/MyRegistrations">Terug naar mijn opleidingen</a></p>
@section Scripts { <script src="~/js/registration-form.js" asp-append-version="true"></script> }
