@using AalstAcademie.Web.Models.Enrolment
@model RegistrationCancelViewModel
@{ ViewData["Title"] = "Mijn aanvraag annuleren"; var row = Model.Registration; }
<h1>Mijn aanvraag annuleren</h1><h2 class="h5">@row.Title</h2>
<p>@row.Date.ToString("dd/MM/yyyy") @row.StartTime.ToString("HH:mm") — @row.Status</p><p class="account-reason">Motivatie: @row.Motivation</p><p class="account-reason">Reden: @row.DecisionReason</p>
<div asp-validation-summary="All" class="text-danger validation-summary" role="alert" tabindex="-1"></div>
<p>Je geeft je plaats vrij. Je wordt hierdoor niet opnieuw op de wachtlijst geplaatst. Een geschikte wachtende kan de plaats innemen.</p>
<form method="post" asp-action="Cancel" asp-route-id="@row.Id">
    <input type="hidden" name="ExpectedRegistrationVersion" value="@EnrolmentHttpForms.Raw(ViewData.ModelState, "ExpectedRegistrationVersion", Model.Input.ExpectedRegistrationVersion)" />
    <input type="hidden" name="ExpectedMomentVersion" value="@EnrolmentHttpForms.Raw(ViewData.ModelState, "ExpectedMomentVersion", Model.Input.ExpectedMomentVersion)" />
    <button type="submit" class="btn btn-danger" disabled="@(Model.IsConflict || !row.CanCancel)">Mijn aanvraag annuleren</button>
</form>
<p><a asp-action="Cancel" asp-route-id="@row.Id">Deze aanvraag bewust opnieuw lezen</a> — <a asp-action="Index">Terug naar mijn opleidingen</a></p>
@section Scripts { <script src="~/js/registration-form.js" asp-append-version="true"></script> }
