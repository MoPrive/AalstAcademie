@using AalstAcademie.Web.Models.Identity
@model AalstAcademie.Web.Models.Accounts.AccountStatusViewModel
@{ ViewData["Title"] = "Mijn accountstatus"; }
@* De toestand bepaalt de uitleg en vervolgstappen; Pending en Refused krijgen geen link naar de toepassing. *@
<h1>Mijn accountstatus</h1>
@* Dit model is uitsluitend uit de huidige identiteit opgebouwd; een invoer-ID kan geen ander account openen. *@
@if (Model.Status == AccountApprovalStatus.Pending)
{
    <div class="alert alert-info">Je aanvraag wacht op beoordeling door een beheerder.</div>
    <p>Je kunt je status bekijken en uitloggen. Na goedkeuring krijg je toegang tot de toepassing.</p>
}
else if (Model.Status == AccountApprovalStatus.Refused)
{
    <div class="alert alert-warning">Je aanvraag is geweigerd.</div>
    <h2 class="h5">Reden</h2>
    @* De reden wordt als geëncodeerde tekst weergegeven; CSS bewaart eventuele regels zonder HTML toe te laten. *@
    <p class="account-reason">@Model.RefusalReason</p>
    <p>Neem contact op met de beheerder als je toelichting nodig hebt. Alleen de beheerder kan je aanvraag heropenen.</p>
}
else if (Model.Status == AccountApprovalStatus.Approved)
{
    <div class="alert alert-success">Je account is goedgekeurd.</div>
    <a class="btn btn-primary" href="/">Naar de toepassing</a>
    @if (Model.IsAdministrator) { <a class="btn btn-outline-primary" href="/Admin/AccountApplications">Accountaanvragen beheren</a> }
}
else { <p>De accountstatus is onbekend. Neem contact op met de beheerder.</p> }
@if (Model.ReviewedAt is not null)
{
    <p class="text-muted mt-3">Laatste beoordeling: @Model.ReviewedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
}
@* Uitloggen blijft voor nog niet goedgekeurde accounts beschikbaar en is een met antiforgery beveiligde POST. *@
<form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Identity/Account/Login" method="post" class="mt-3">
    <button class="btn btn-outline-secondary" type="submit">Uitloggen</button>
</form>
