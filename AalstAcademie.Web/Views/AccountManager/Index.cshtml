@using AalstAcademie.Web.Models.Enrolment
@model AalstAcademie.Web.Models.Accounts.AccountManagerViewModel
@{ ViewData["Title"] = "Leidinggevende";
    var chosen = EnrolmentHttpForms.Raw(ViewData.ModelState, "ManagerUserId", Model.Input.ManagerUserId);
    var stamp = EnrolmentHttpForms.Raw(ViewData.ModelState, "ExpectedConcurrencyStamp", Model.Input.ExpectedConcurrencyStamp); }
<h1>Leidinggevende</h1><p>@Model.DisplayName — huidige leidinggevende: @(Model.CurrentManagerName ?? "Geen")</p>
@if (TempData["EnrolmentMessage"] is string message) { <p class="alert alert-success" role="status">@message</p> }
<div asp-validation-summary="All" class="text-danger validation-summary" role="alert" tabindex="-1"></div>
<form method="post" action="/AccountManager" class="account-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ExpectedConcurrencyStamp" value="@stamp" />
    <fieldset><legend>Optionele leidinggevende</legend>
        <label for="ManagerUserId" class="form-label">Leidinggevende</label>
        <select name="ManagerUserId" id="ManagerUserId" class="form-select">
            @if (!Model.Choices.Any(x => (x.UserId ?? "") == chosen)) { <option value="@chosen" selected>Oorspronkelijke keuze niet beschikbaar — lees opnieuw</option> }
            @foreach (var c in Model.Choices) { <option value="@c.UserId" selected="@((c.UserId ?? "") == chosen)">@c.DisplayName</option> }
        </select>
        @Html.ValidationMessage("ManagerUserId", null, new { @class = "text-danger" })
        <p class="form-text">Geen is toegestaan. Deze keuze verandert geen afdeling, rollen of goedkeuring.</p>
    </fieldset>
    @if (Context.Response.StatusCode != 409) { <button class="btn btn-primary" type="submit">Leidinggevende opslaan</button> }
</form>
<p class="mt-3"><a href="/AccountManager">Profiel bewust opnieuw lezen</a></p>
@section Scripts { <script src="~/js/registration-form.js" asp-append-version="true"></script> }
