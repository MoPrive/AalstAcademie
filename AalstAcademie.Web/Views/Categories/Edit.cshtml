@* Sprint 003: Toont hernoemen met de oorspronkelijke versie en behoud van ongeldige naam. Bewust herlezen levert pas een nieuwe versie. *@
@using AalstAcademie.Web.Models.Training
@model CategoryEditViewModel
@{ ViewData["Title"] = "Categorie hernoemen"; }
<h1>Categorie hernoemen</h1>
<p><a asp-action="Index">Terug naar de categorieën</a></p>
<div asp-validation-summary="All" class="text-danger validation-summary" role="alert" tabindex="-1"></div>
@if (Model.Message is not null) { <p class="alert alert-warning" role="alert">@Model.Message</p> }
@if (Model.IsConflict)
{
    @* De oorspronkelijke naam en shadowversie blijven bewaard; een conflict wordt nooit automatisch opnieuw verstuurd. *@
    <p>Je ingevoerde naam blijft hieronder zichtbaar. Lees eerst de huidige categorie opnieuw voordat je een nieuwe wijziging opslaat.</p>
    <p><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Huidige gegevens opnieuw lezen</a></p>
}
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="account-form">
    <input asp-for="ExpectedVersion" type="hidden" />
    <fieldset>
        <legend>Categorienaam</legend>
        <label asp-for="Name" class="form-label">Naam (verplicht)</label>
        <input asp-for="Name" type="text" class="form-control" maxlength="100" required aria-describedby="NameHelp" />
        <p id="NameHelp" class="form-text">Maximaal 100 tekens. Hernoemen bewaart alle koppelingen met bestaande opleidingen.</p>
        <span asp-validation-for="Name" class="text-danger"></span>
    </fieldset>
    @if (!Model.IsConflict) { <button type="submit" class="btn btn-primary">Nieuwe naam opslaan</button> }
</form>
@section Scripts { <script src="~/js/registration-form.js" asp-append-version="true"></script> }
