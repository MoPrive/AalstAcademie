@* Sprint 003: Bewaart raw zaalinput en oude versie bij fouten. Het getoonde beschermde minimum helpt de beheerder; de schrijfservice leest het opnieuw. *@
@using AalstAcademie.Web.Models.Training
@model LocationEditViewModel
@{ ViewData["Title"] = "Zaal wijzigen"; }
@* Historische momenten lezen dezelfde zaalnaam; een oude versie wordt nooit automatisch vernieuwd. *@
<h1>Zaal wijzigen</h1><p><a asp-action="Index">Terug naar het zaaloverzicht</a></p>
<p>Huidig minimum door nog niet geëindigde geplande momenten: @Model.Details.MinimumCapacity. Een verhoging verandert geen deelnemersmaximum.</p>
<div asp-validation-summary="All" class="text-danger training-validation-summary" role="alert" tabindex="-1" autofocus></div><form asp-action="Edit" asp-route-id="@Model.Details.Id" method="post" class="location-form">
<input asp-for="ExpectedVersion" type="hidden" /><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span>
<label asp-for="Address"></label><textarea asp-for="Address" class="form-control"></textarea><span asp-validation-for="Address" class="text-danger"></span>
<label asp-for="MaximumCapacity"></label><input asp-for="MaximumCapacity" class="form-control" inputmode="numeric" /><span asp-validation-for="MaximumCapacity" class="text-danger"></span>
<button class="btn btn-primary mt-3" type="submit">Zaal opslaan</button></form>
<p class="mt-3"><a asp-action="Edit" asp-route-id="@Model.Details.Id">Zaal opnieuw lezen</a></p>

