@model AalstAcademie.Web.Models.Enrolment.EmployeeCataloguePage
@{ ViewData["Title"] = "Opleidingsaanbod"; }
@* Alleen actuele passende momenten; de lijst reserveert geen plaats en bevat geen deelnemersgegevens. *@
<h1>Opleidingsaanbod</h1>
<div asp-validation-summary="All" class="text-danger validation-summary" role="alert" tabindex="-1"></div>
<form method="get" class="training-actions mb-3">
    <label for="categoryId">Categorie</label>
    <select name="categoryId" id="categoryId" class="form-select w-auto">
        <option value="">Alle categorieën</option>
        @foreach (var c in Model.Categories ?? []) { <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option> }
    </select>
    <button class="btn btn-primary" type="submit">Filteren</button>
</form>
@if (Model.Rows?.Count > 0)
{
    @foreach (var row in Model.Rows)
    {
        <article class="card mb-3"><div class="card-body">
            <h2 class="h4"><a href="/EmployeeCatalogue/Moment/@row.MomentId">@row.Title</a></h2>
            <p>@row.Category — @row.Date.ToString("dd/MM/yyyy") @row.StartTime.ToString("HH:mm")–@row.EndTime.ToString("HH:mm")</p>
            <p>@row.Location — @row.InstructorName</p>
            <p>Direct beschikbare plaatsen: @row.DirectAvailable. @(row.DirectAvailable == 0 ? "Bekijk dit moment voor een bewuste wachtlijstkeuze." : "Een aanvraag wacht daarna op beoordeling.")</p>
        </div></article>
    }
    <nav aria-label="Aanbodpagina's" class="training-actions">
        @if (Model.Page > 1) { <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" asp-route-page="@(Model.Page - 1)">Vorige</a> }
        <span>Pagina @Model.Page van @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" asp-route-page="@(Model.Page + 1)">Volgende</a> }
    </nav>
}
else { <p>Er zijn momenteel geen passende toekomstige opleidingsmomenten.</p> }
@section Scripts { <script src="~/js/registration-form.js" asp-append-version="true"></script> }
